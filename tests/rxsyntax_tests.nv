// rxsyntax_tests.nv — the parser, the classes, the compiler and the
// two refusals that are the linear-time guarantee.
//
// RED ON PURPOSE: every body under `src/` is a `todo()`, so every
// assertion here reaches `not implemented: regex-core-nv.<module>.<fn>`.

use std.test
use std.list
use rxast
use rxclass
use rxerr
use rxmatch
use rxprog
use udata

fn tables() -> UniData
    udata.data_compact()

@test
fn test_a_back_reference_and_a_lookaround_are_refused_by_name() [io]
    // NOT gaps.  Neither can be matched in time linear in the subject,
    // and the whole design rests on that bound — so the refusal says
    // what it is rather than reading as a typo the author should fix.
    test.case("a back-reference")
    match rxast.parse(tables(), "(a)\\1", rxclass.default_flags(), rxerr.default_limits())
        Ok(_)  => test.assert(false)
        Err(e) =>
            test.assert(rxerr.is_by_design(e))

    test.case("lookahead")
    match rxast.parse(tables(), "a(?=b)", rxclass.default_flags(), rxerr.default_limits())
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(rxerr.is_by_design(e))

    test.case("lookbehind")
    match rxast.parse(tables(), "(?<=a)b", rxclass.default_flags(), rxerr.default_limits())
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(rxerr.is_by_design(e))

    test.case("and an unclosed bracket is a mistake rather than a design decision")
    match rxast.parse(tables(), "a(b", rxclass.default_flags(), rxerr.default_limits())
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(not rxerr.is_by_design(e))

@test
fn test_a_fault_names_the_byte_it_is_about() [io]
    // A pattern is one line with no line numbers in it, so a consumer
    // that can underline the clause reports something a person can act
    // on and one that cannot says "invalid pattern".
    test.case("the unclosed group is at byte 1")
    match rxast.parse(tables(), "a(b", rxclass.default_flags(), rxerr.default_limits())
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(rxerr.offset_of(e) == 1)

    test.case("and a stray close is at byte 2")
    match rxast.parse(tables(), "ab)", rxclass.default_flags(), rxerr.default_limits())
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(rxerr.offset_of(e) == 2)

@test
fn test_a_counted_repetition_is_bounded_at_compile_time() [io]
    // `{1000}{1000}{1000}` is linear to MATCH and cubic to COMPILE,
    // which is the denial of service a program limit exists for — and
    // the one a caller who only bounded the subject has not defended
    // against.
    test.case("the default repeat ceiling is a number, not unlimited")
    test.assert(rxerr.default_limits().max_repeat > 0)

    test.case("an untrusted caller asks for a smaller one")
    test.assert(rxerr.untrusted_limits().max_repeat < rxerr.default_limits().max_repeat)

    test.case("and a repetition past it is refused rather than expanded")
    match rxast.parse(tables(), "a{100000}", rxclass.default_flags(),
                      rxerr.untrusted_limits())
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("{2,1} is refused — a minimum above its maximum")
    match rxast.parse(tables(), "a{2,1}", rxclass.default_flags(),
                      rxerr.default_limits())
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_a_class_is_sorted_disjoint_ranges_and_negate_is_a_complement() [io]
    // A predicate cannot be negated cheaply, unioned at compile time,
    // case-folded, or turned into the byte ranges a lazy DFA needs.
    // Ranges do all four with a merge — and the normal form has to be
    // enforced by the constructors, because a `negate` over an
    // unnormalised list is wrong in a way no test of `matches` finds.
    match rxclass.range(97, 122, 0)
        Err(_) => test.assert(false)
        Ok(az) =>
            test.case("a-z holds 26 codepoints")
            test.assert(rxclass.cardinality(az) == 26)

            test.case("and it holds them")
            test.assert(rxclass.matches(az, 109))

            test.case("its complement does not")
            test.assert(not rxclass.matches(rxclass.negate(az), 109))

            test.case("and negating twice is the identity")
            test.assert(rxclass.matches(rxclass.negate(rxclass.negate(az)), 109))

    test.case("[z-a] is refused rather than normalised to nothing")
    match rxclass.range(122, 97, 3)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a union of two singletons holds both")
    let both = rxclass.union(rxclass.one(65), rxclass.one(66))
    test.assert(rxclass.matches(both, 65) and rxclass.matches(both, 66))

    test.case("an intersection of disjoint singletons holds nothing")
    test.assert(rxclass.is_empty(rxclass.intersect(rxclass.one(65), rxclass.one(66))))

    test.case("and a difference with itself holds nothing")
    test.assert(rxclass.is_empty(rxclass.difference(rxclass.one(65), rxclass.one(65))))

@test
fn test_case_folding_happens_at_compile_time_and_covers_the_kelvin_sign() [io]
    // A matcher that lowercased each subject byte would be wrong for
    // every character whose fold is not a single codepoint, and would
    // pay for the fold on every byte of every subject.  K, k and the
    // Kelvin sign U+212A are one fold group, which is the case that
    // separates a real implementation from a `+ 32`.
    test.case("K folds to k")
    test.assert(rxclass.matches(rxclass.fold_case(tables(), rxclass.one(75)), 107))

    test.case("and to the Kelvin sign")
    test.assert(rxclass.matches(rxclass.fold_case(tables(), rxclass.one(75)), 8490))

    test.case("the ASCII fold does the first and not the second")
    test.assert(rxclass.matches(rxclass.fold_case_ascii(rxclass.one(75)), 107))
    test.assert(not rxclass.matches(rxclass.fold_case_ascii(rxclass.one(75)), 8490))

@test
fn test_the_shorthand_classes_have_two_meanings_and_the_mode_picks_one() [io]
    // `\w` is `[0-9A-Za-z_]` in ASCII and any Unicode letter in Unicode
    // mode.  This is the ONE difference that changes an answer rather
    // than adding a feature, and it is why a pattern validating an
    // identifier silently starts accepting one written in Greek when it
    // moves here from `std.regex`.
    test.case("an underscore is a word character in both modes")
    test.assert(rxclass.matches(rxclass.word(tables(), RxAscii), 95))
    test.assert(rxclass.matches(rxclass.word(tables(), RxUnicode), 95))

    test.case("a Greek alpha is one only in Unicode mode")
    test.assert(not rxclass.matches(rxclass.word(tables(), RxAscii), 945))
    test.assert(rxclass.matches(rxclass.word(tables(), RxUnicode), 945))

    test.case("an Arabic-Indic digit is a digit only in Unicode mode")
    test.assert(not rxclass.matches(rxclass.digit(tables(), RxAscii), 1633))
    test.assert(rxclass.matches(rxclass.digit(tables(), RxUnicode), 1633))

    test.case("a space is whitespace in both")
    test.assert(rxclass.matches(rxclass.space(tables(), RxAscii), 32))

    test.case("and . excludes the newline until s is set")
    test.assert(not rxclass.matches(rxclass.dot(tables(), rxclass.default_flags()), 10))

@test
fn test_a_property_or_posix_name_nobody_defines_is_refused() [io]
    // RE2's behaviour, and the opposite of a leniency that turns
    // `[[:alhpa:]]` into a class of eight letters and a colon.
    test.case("a good POSIX class")
    match rxclass.posix_class(tables(), "xdigit", RxAscii, 2)
        Err(_) => test.assert(false)
        Ok(c)  => test.assert(rxclass.matches(c, 70))

    test.case("a typo in one is refused")
    match rxclass.posix_class(tables(), "alhpa", RxAscii, 2)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a real general category")
    match rxclass.property(tables(), "Nd", 3)
        Err(_) => test.assert(false)
        Ok(c)  => test.assert(rxclass.matches(c, 53))

    test.case("and an invented one is refused")
    match rxclass.property(tables(), "Nosuch", 3)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("the names are published so a consumer can suggest one")
    test.assert(list.len(rxclass.property_names()) > 0)

@test
fn test_an_unknown_inline_flag_is_refused_rather_than_ignored() [io]
    // An ignored `(?p)` is a pattern that silently means something
    // other than what its author wrote, which is worse than a refusal
    // by exactly the amount of time it takes to notice.
    test.case("i is a flag")
    match rxclass.flag_set(rxclass.default_flags(), "i", true, 2)
        Err(_) => test.assert(false)
        Ok(f)  => test.assert(f.case_insensitive)

    test.case("m is a flag")
    match rxclass.flag_set(rxclass.default_flags(), "m", true, 2)
        Err(_) => test.assert(false)
        Ok(f)  => test.assert(f.multi_line)

    test.case("and p is not")
    match rxclass.flag_set(rxclass.default_flags(), "p", true, 2)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_the_tree_answers_what_a_consumer_asks_without_matching() [io]
    // Three consumers need to ASK something about a pattern without
    // matching anything, and none of those questions can be answered
    // from a compiled program.  Publishing the tree is what stops each
    // of them writing a second parser.
    match rxast.parse(tables(), "(?<y>[0-9]{4})-[0-9]{2}", rxclass.default_flags(),
                      rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(a)  =>
            test.case("one capturing group")
            test.assert(a.group_count == 1)

            test.case("found by name")
            match rxast.group_index(a, "y")
                None    => test.assert(false)
                Some(i) => test.assert(i == 1)

            test.case("and a name nobody declared is absent")
            match rxast.group_index(a, "m")
                Some(_) => test.assert(false)
                None    => test.assert(true)

            test.case("the constructs are named in the vocabulary a profile uses")
            test.assert(list.len(rxast.constructs_used(a.root[0])) > 0)

            test.case("the node knows where it came from")
            test.assert(rxast.span_of(a.root[0]).start == 0)

            test.case("and the tree prints back as a pattern")
            test.assert(rxast.to_pattern(a.root[0]) != "")

            // A group's one child is behind a list because a recursive
            // enum needs its recursion behind one; `node_child` is
            // where that encoding is said once instead of at every
            // call site that would otherwise index a list.
            test.case("a group has exactly one child")
            match rxast.node_child(a.root[0])
                Some(_) => test.assert(true)
                None    => test.assert(true)

            test.case("and a literal has none")
            match rxast.node_child(RxLiteral(RxSpan { start: 0, end: 1 }, 97))
                Some(_) => test.assert(false)
                None    => test.assert(true)

@test
fn test_matches_empty_and_is_anchored_are_asked_before_anything_runs() [io]
    // `(a*)*` over an inner node that can match nothing is the loop that
    // never terminates in a naive Thompson construction, and a
    // separator that matches the empty string splits between every
    // character.  Both consumers want the answer before they start.
    match rxast.parse(tables(), "a*", rxclass.default_flags(), rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(a)  => test.assert(rxast.matches_empty(a.root[0]))

    test.case("a+ cannot")
    match rxast.parse(tables(), "a+", rxclass.default_flags(), rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(a)  => test.assert(not rxast.matches_empty(a.root[0]))

    test.case("^a is anchored at the start")
    match rxast.parse(tables(), "^a", rxclass.default_flags(), rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(a)  => test.assert(rxast.is_anchored_start(a.root[0]))

    test.case("and escaping makes a metacharacter a literal")
    test.assert(rxast.escape("a.b*c") != "a.b*c")

@test
fn test_the_engine_choice_is_a_value_a_caller_can_read() [io]
    // "My regex got slow" is unactionable; "asking for groups turned the
    // DFA off" is a sentence somebody can act on.  The DFA carries no
    // capture slots, so a caller that asks for groups gets the Pike VM
    // however simple the pattern is.
    match rxprog.build(tables(), "needle", rxclass.default_flags(),
                       rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(p)  =>
            test.case("a plain literal is a substring search and not an engine at all")
            match rxprog.engine_for(p, false)
                RxLiteralScan => test.assert(true)
                _             => test.assert(false)

            test.case("and its literal prefix is the whole of it")
            test.assert(rxprog.literal_prefix(p) == "needle")

    match rxprog.build(tables(), "([0-9]+)-([0-9]+)", rxclass.default_flags(),
                       rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(p)  =>
            test.case("asking for groups is what selects the Pike VM")
            match rxprog.engine_for(p, true)
                RxPikeVm => test.assert(true)
                _        => test.assert(false)

            test.case("and not asking leaves the DFA available")
            match rxprog.engine_for(p, false)
                RxPikeVm => test.assert(false)
                _        => test.assert(true)

            test.case("the engine names itself for a log")
            test.assert(rxprog.engine_name(RxPikeVm) != "")

            test.case("two groups, and the program has instructions in it")
            test.assert(rxprog.group_count(p) == 2)
            test.assert(rxprog.insn_count(p) > 0)
            test.assert(list.len(rxprog.group_names(p)) == 2)

@test
fn test_the_prefilter_and_the_anchor_are_what_keep_a_long_subject_linear() [io]
    // A search for "ERROR: [0-9]+" over a gigabyte of log should not
    // touch the engine for most of it, and an anchored pattern should
    // not try every starting position.
    match rxprog.build(tables(), "ERROR: [0-9]+", rxclass.default_flags(),
                       rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(p)  =>
            test.case("the prefix a substring search can find")
            test.assert(rxprog.literal_prefix(p) == "ERROR: ")

            test.case("the shortest subject it could match")
            test.assert(rxprog.min_length(p) == 8)

            test.case("and it is not anchored")
            test.assert(not rxprog.is_anchored(p))

    match rxprog.build(tables(), "^a", rxclass.default_flags(), rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(p)  => test.assert(rxprog.is_anchored(p))

    test.case("a program can be read back, which is what an implementer needs")
    match rxprog.build(tables(), "a", rxclass.default_flags(), rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(p)  => test.assert(rxprog.disassemble(p) != "")

@test
fn test_an_ascii_pattern_can_prove_it_does_not_touch_the_tables() [io]
    // unicode-nv's tables are the largest thing this package's closure
    // pulls in, and a caller matching protocol tokens does not need
    // them.  Proving it BEFORE matching is what lets such a caller
    // refuse a pattern rather than discover the cost at match time.
    match rxprog.build(tables(), "[0-9A-Za-z_-]+", rxclass.ascii_flags(),
                       rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(p)  => test.assert(not rxprog.needs_tables(p))

    test.case("and a property class does need them")
    match rxprog.build(tables(), "\\p{Greek}+", rxclass.default_flags(),
                       rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(p)  => test.assert(rxprog.needs_tables(p))

    test.case("a plain class does not, whatever the mode")
    test.assert(not rxclass.needs_tables(rxclass.one(65)))

    test.case("the two-step and the one-step compile agree")
    match rxast.parse(tables(), "a", rxclass.default_flags(), rxerr.default_limits())
        Err(_) => test.assert(false)
        Ok(a)  =>
            match rxprog.compile(a, rxerr.default_limits())
                Err(_) => test.assert(false)
                Ok(p)  => test.assert(rxprog.insn_count(p) > 0)

@test
fn test_linear_time_is_the_guarantee_and_the_pathological_pattern_is_immediate() [io]
    // Exponential in PCRE, Python and Java.  A Thompson NFA simulation
    // has no backtracking, so the time is bounded by the program length
    // times the subject length and this answers at once.
    match rxmatch.compile(tables(), "(a+)+b")
        Err(_) => test.assert(false)
        Ok(r)  => test.assert(not rxmatch.is_match(r, "aaaaaaaaaaaaaaaaaaaaaaaaa"))
